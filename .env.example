# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Required ---------------------------------------------------------------

# Gemini: picks and watches moments, finds the facecam. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Extra keys (comma-separated) are rotated when one hits its limit
GEMINI_API_KEYS=

# Groq: transcription (Whisper) and small text steps. Free key: https://console.groq.com/keys
# Without it, transcription runs locally on CPU (pip install -r requirements-local.txt) - much slower.
GROQ_API_KEY=
GROQ_API_KEYS=

# --- Optional ---------------------------------------------------------------

# OpenRouter: runs the text-only steps on free models so Gemini quota is kept for video. https://openrouter.ai/keys
OPENROUTER_API_KEYS=

# Viewer-made Twitch clips as an extra signal. Free app: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Cookies, for age-restricted / sub-only / bot-checked videos (use ONE).
# A cookies.txt exported from your browser is the most reliable; relative paths are from the project folder.
YTDLP_COOKIES_FILE=
# ...or a browser name: firefox, edge, chrome, brave
YTDLP_COOKIES_BROWSER=

# --- Model overrides (leave empty for defaults) -----------------------------
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_FALLBACK_MODEL=
OPENROUTER_MODELS=
GROQ_WHISPER_MODEL=
GROQ_TEXT_MODELS=
LOCAL_WHISPER_MODEL=
# seconds to spend on chat replay before giving up (default 600)
CHAT_TIMEOUT=
