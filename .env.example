# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Extra keys from other Google accounts, comma-separated - rotated when one hits its daily limit
GEMINI_API_KEYS=

# Optional, free: https://openrouter.ai/keys - does the text-only steps so Gemini quota is kept for watching video.
# Comma-separate several keys to rotate them. OPENROUTER_MODELS = models tried in order.
OPENROUTER_API_KEYS=
OPENROUTER_MODELS=
GEMINI_MODEL=gemini-3.8-flash

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Extra Groq keys from other accounts, comma-separated - rotated when one is rate limited
GROQ_API_KEYS=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# The same Groq keys also run fast free text models for small steps (rerank). Tried in order.
GROQ_TEXT_MODELS=

# Used only if GROQ_API_KEY is empty (pip install -r requirements-local.txt)
LOCAL_WHISPER_MODEL=small

# --- Cookies for age-restricted videos (use ONE) ---
# Path to a cookies.txt exported from your browser (most reliable on Windows)
YTDLP_COOKIES_FILE=
# Or a browser name: firefox, edge, chrome, brave (Chrome/Edge often fail on Windows while open)
YTDLP_COOKIES_BROWSER=

# --- Optional: viewer-made Twitch clips as a signal (free app: https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Optional: separate model for the visual pass (defaults to GEMINI_MODEL) ---
GEMINI_VISION_MODEL=
GEMINI_FALLBACK_MODEL=
CHAT_TIMEOUT=600
